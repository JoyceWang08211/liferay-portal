definition {

	@summary = "Add a public site page or public child site page to an existing site template via site template name"
	macro addLayoutToSiteTemplate {
		Variables.assertDefined(parameterList = "${layoutName},${siteTemplateName}");

		var groupKey = JSONSiteTemplateSetter.setLayoutSetPrototypeId(siteTemplateName = "${siteTemplateName}");

		var groupId = JSONLayoutSetter.setGroupId(groupKey = "${groupKey}", site = "false");

		var parentLayoutId = JSONLayoutSetter.setParentLayoutId(
			groupId = "${groupId}",
			parentLayoutName = "${parentLayoutName}",
			privateLayout = "true");

		var serviceContext = JSONLayoutSetter.setServiceContext(
			assetCategoryIds = "${assetCategoryIds}",
			assetTagNames = "${assetTagNames}",
			serviceContext = "${serviceContext}",
			workflowAction = "${workflowAction}");

		var type = JSONLayoutSetter.setType(type = "${type}");

		JSONLayoutAPI._addLayout(
			friendlyURL = "",
			groupId = "${groupId}",
			layoutName = "${layoutName}",
			parentLayoutId = "${parentLayoutId}",
			privateLayout = "true",
			serviceContext = "${serviceContext}",
			type = "${type}");
	}

	@summary = "Add a site template via site template name"
	macro addSiteTemplate {
		Variables.assertDefined(parameterList = "${siteTemplateName}");

		var active = JSONSiteTemplateSetter.setActive(active = "${active}");

		var description = JSONSiteTemplateSetter.setDescription(description = "${description}");

		var readyForPropagation = JSONSiteTemplateSetter.setReadyForPropagation(readyForPropagation = "${readyForPropagation}");

		var updateable = JSONSiteTemplateSetter.setUpdateable(updateable = "${updateable}");

		JSONSiteTemplateAPI._addSiteTemplate(
			active = "${active}",
			description = "${description}",
			readyForPropagation = "${readyForPropagation}",
			siteTemplateName = "${siteTemplateName}",
			updateable = "${updateable}");
	}

	@summary = "Add a site based on site template via site template name"
	macro addSiteTemplateSite {
		Variables.assertDefined(parameterList = "${groupName},${siteTemplateName}");

		JSONGroup.addGroup(groupName = "${groupName}");

		var groupId = JSONGroupSetter.setGroupId(groupName = "${groupName}");

		var layoutSetPrototypeUuid = JSONSiteTemplateSetter.setLayoutSetPrototypeUuid(siteTemplateName = "${siteTemplateName}");

		JSONSiteTemplateAPI._updateLayoutSetPrototypeLinkEnabled(
			groupId = "${groupId}",
			layoutSetPrototypeUuid = "${layoutSetPrototypeUuid}");
	}

	@summary = "Delete all non-default site templates"
	macro deleteAllSiteTemplates {
		JSONSiteTemplateAPI._deleteAllSiteTemplates();
	}

	@summary = "Delete a site template using its siteTemplateName"
	macro deleteSiteTemplateByName {
		Variables.assertDefined(parameterList = "${siteTemplateName}");

		var layoutSetPrototypeId = JSONSiteTemplateSetter.setLayoutSetPrototypeId(siteTemplateName = "${siteTemplateName}");

		JSONSiteTemplateAPI._deleteSiteTemplate(layoutSetPrototypeId = "${layoutSetPrototypeId}");
	}

}