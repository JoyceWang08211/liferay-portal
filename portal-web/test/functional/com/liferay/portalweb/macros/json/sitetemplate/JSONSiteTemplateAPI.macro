definition {

	@summary = "Directly calls the JSON WS API to add a site template"
	macro _addSiteTemplate {
		Variables.assertDefined(parameterList = "${siteTemplateName},${description},${active},${updateable},${readyForPropagation}");

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/layoutsetprototype/add-layout-set-prototype \
				-u test@liferay.com:test \
				-d name=${siteTemplateName} \
				-d description=${description} \
				-d active=${active} \
				-d layoutsUpdateable=${updateable} \
				-d readyForPropagation=${readyForPropagation}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@summary = "Directly calls the JSON WS API to delete all non-default site templates"
	macro _deleteAllSiteTemplates {
		var portalURL = JSONCompany.getPortalURL();

		var companyId = JSONCompany.getCompanyId();

		var curl = '''
			${portalURL}/api/jsonws/layoutsetprototype/delete-nondefault-layout-set-prototypes \
				-u test@liferay.com:test \
				-d companyId=${companyId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@summary = "Directly calls the JSON WS API to delete a site templates by using layoutSetPrototypeId"
	macro _deleteSiteTemplate {
		Variables.assertDefined(parameterList = "${layoutSetPrototypeId}");

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/layoutsetprototype/delete-layout-set-prototype \
				-u test@liferay.com:test \
				-d layoutSetPrototypeId=${layoutSetPrototypeId}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@summary = "Get the layoutSetPrototypeId from a layoutSetPrototype by using siteTemplateName"
	macro _getLayoutSetPrototypeIdByName {
		Variables.assertDefined(parameterList = "${siteTemplateName}");

		var portalURL = JSONCompany.getPortalURL();

		var companyId = JSONCompany.getCompanyId();

		var curl = '''
			${portalURL}/api/jsonws/layoutsetprototype/get-layout-set-prototypes \
				-u test@liferay.com:test \
				-d companyId=${companyId}
		''';

		var layoutSetPrototypeId = JSONCurlUtil.post("${curl}", "$.[?(@['nameCurrentValue'] == '${siteTemplateName}')]['layoutSetPrototypeId']");
		var layoutSetPrototypeId = StringUtil.replace("${layoutSetPrototypeId}", "[&quot;", "");
		var layoutSetPrototypeId = StringUtil.replace("${layoutSetPrototypeId}", "&quot;]", "");

		if ("${layoutSetPrototypeId}" == "[]") {
			fail("FAIL. Cannot find site template.");
		}

		return "${layoutSetPrototypeId}";
	}

	@summary = "Get the uuid from a layoutSetPrototype by using siteTemplateName"
	macro _getLayoutSetPrototypeUuIdByName {
		Variables.assertDefined(parameterList = "${siteTemplateName}");

		var portalURL = JSONCompany.getPortalURL();

		var companyId = JSONCompany.getCompanyId();

		var curl = '''
			${portalURL}/api/jsonws/layoutsetprototype/get-layout-set-prototypes \
				-u test@liferay.com:test \
				-d companyId=${companyId}
		''';

		var uuid  = JSONCurlUtil.post("${curl}", "$.[?(@['nameCurrentValue'] == '${siteTemplateName}')]['uuid']");
		var uuid  = StringUtil.replace("${uuid}", "[&quot;", "");
		var layoutSetPrototypeUuid  = StringUtil.replace("${uuid}", "&quot;]", "");

		if ("${layoutSetPrototypeUuid }" == "[]") {
			fail("FAIL. Cannot find site template.");
		}

		echo("## Uuid: ${layoutSetPrototypeUuid}");

		return "${layoutSetPrototypeUuid}";
	}

	@summary = "Directly calls the JSON WS API to update LayoutSetPrototype"
	macro _updateLayoutSetPrototypeLinkEnabled {
		Variables.assertDefined(parameterList = "${groupId},${layoutSetPrototypeUuid}");

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/layoutset/update-layout-set-prototype-link-enabled \
				-u test@liferay.com:test \
				-d groupId=${groupId} \
				-d privateLayout=true \
				-d layoutSetPrototypeLinkEnabled=true \
				-d layoutSetPrototypeUuid=${layoutSetPrototypeUuid}
		''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

}