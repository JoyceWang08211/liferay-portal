@component-name = "portal-staging"
definition {

	property ci.retries.disabled = "true";
	property custom.properties = "upgrade.database.auto.run=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property rebuild.staging.database = "true";
	property testray.main.component.name = "Export/Import Framework";

	setUp {
		task ("Setup: Setup portal instance and login to portal") {
			TestCase.setUpCustomPortalInstance();

			User.firstLoginPG();
		}

		task ("Setup: Delete user profile image") {
			MyAccount.openMyAccountAdmin();

			User.deleteProfileImage();

			PortletEntry.save();
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCustomPortal();
		}
		else {
			Site.tearDownCP();
		}
	}

	@priority = 4
	test Import6210buildNumber {
		LAR.importSiteCP(
			cannotImport = "true",
			import6210buildNumber = "true",
			importFail = "true",
			larFileName = "6210buildNumber.lar",
			siteName = "Guest",
			uploadFrom = "dependencies");
	}

}